
# Copy this file to .env and replace the placeholders with your own values.

# Base URL of the llama.cpp OpenAI-compatible server (loopback is the default).
GGUF_SERVER_URL=http://127.0.0.1:8080/v1

# Model id passed to TOKN. Replace the placeholder with the id your server reports.
TOKN_MODEL=<your-model-id>

# Optional: force limited-capability mode on (1) or off (0).
# Leave unset to let TOKN decide from the model id (sizes of 8B and below).
#NOSPACE_LIMITED_MODEL=1

# Optional: output token cap per reply (default 8192 in limited mode).
#TOKN_MAX_OUTPUT_TOKENS=8192

# Optional: path to the tokn binary if it is not on PATH.
#TOKN_BIN=<path-to-tokn>

# NOTE: SYSTEMONE_ALLOW_LOCAL and the other SYSTEMONE_* settings must be set in
# your shell, NOT in this file. TOKN deliberately does not load them from .env.
