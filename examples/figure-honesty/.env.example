# Copy to .env and fill in. Placeholders only. Never commit .env.

# Anthropic API key, or the key issued by your Anthropic-compatible gateway.
ANTHROPIC_API_KEY=your-key-here

# Optional: an Anthropic-compatible gateway. Leave commented to use the default endpoint.
# ANTHROPIC_BASE_URL=https://your-gateway.example.com/anthropic

# Vision model that checks figures. Must be vision-capable.
TOKN_VISION_PROVIDER=anthropic
TOKN_VISION_MODEL=claude-haiku-5-5

# Optional: turn the figure honesty gate off for a run.
# TOKN_FIGURE_GATES=off

# Optional: where goal scopes are stored. Defaults to ~/.tokn/goalscopes.
# TOKN_GOALSCOPE_DIR=/path/to/goalscopes
