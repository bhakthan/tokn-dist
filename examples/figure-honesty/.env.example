# Reference template only. Set routing and secrets in a trusted shell;
# never source repository .env or commit .env.

# Anthropic API key, or the key issued by your Anthropic-compatible gateway.
ANTHROPIC_API_KEY=

# Optional: an Anthropic-compatible gateway. Leave commented to use the default endpoint.
# Set ANTHROPIC_BASE_URL in your trusted shell if applicable.

# Vision model that checks figures. Must be vision-capable.
# Set TOKN_VISION_PROVIDER and TOKN_VISION_MODEL in your trusted shell.
# NOSPACE_MODEL_PROVIDER=anthropic
# NOSPACE_MODEL_NAME=YOUR_MODEL_ID

# Optional: where goal scopes are stored. Defaults to ~/.tokn/goalscopes.
# TOKN_GOALSCOPE_DIR=/path/to/goalscopes
