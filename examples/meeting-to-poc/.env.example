# Template for reference only. Set these in a trusted shell; do not source this
# file or commit a populated .env. Empty values do not satisfy preflight.
#
# Path A (default): any provider that can make tool calls. Anthropic shown.
# NOSPACE_MODEL_PROVIDER=anthropic
# NOSPACE_MODEL_NAME=YOUR_MODEL_ID
ANTHROPIC_API_KEY=
#
# Path B (optional, WorkIQ demo): generation uses an Azure OpenAI deployment.
# NOSPACE_MODEL_PROVIDER=azure-openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Key, or leave blank and use DefaultAzureCredential (az login).
AZURE_OPENAI_API_KEY=
# Optional, only for a non-default WorkIQ app registration (see `tokn workiq --help`):
# WORKIQ_APP_ID=
# WORKIQ_TENANT=
#
# Optional: TOKN_NO_REGISTER=1 and TOKN_NO_UPDATE_CHECK=1
