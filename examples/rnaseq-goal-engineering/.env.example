# Template for reference only. Set these in a trusted shell; do not source this
# file or commit a populated .env. Empty values do not satisfy preflight.

# NOSPACE_MODEL_PROVIDER=anthropic
# NOSPACE_MODEL_NAME=YOUR_MODEL_ID
# Anthropic API key, or the key issued by your Anthropic-compatible gateway.
ANTHROPIC_API_KEY=

# Optional: an Anthropic-compatible gateway. Leave commented to use the default endpoint.
# ANTHROPIC_BASE_URL=

# Optional: override the auth header the endpoint expects.
# ANTHROPIC_AUTH_HEADER=

# Optional: route every run to the cheapest rung that can do each step.
# Same effect as passing --auto-route.
# TOKN_AUTO_ROUTE=1

# Recommended: keep this exercise's goal scopes and lessons in the run root
# (see README Setup). Defaults to ~/.tokn/goalscopes.
# TOKN_GOALSCOPE_DIR=

# Optional: TOKN_NO_REGISTER=1 and TOKN_NO_UPDATE_CHECK=1
