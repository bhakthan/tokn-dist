# Copy this file to .env to keep your own values in one place. Replace every
# <placeholder> with your own value. Do not commit .env.
#
# IMPORTANT: TOKN refuses AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_USE_DEFAULT_CREDENTIAL
# when they come from a repository .env, and run.ps1 / run.sh read this file for
# nothing. Export the values in your real shell (see README step 1).

# Your Azure OpenAI resource endpoint, ending in /openai/v1.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1

# The deployment name. Must equal model.model in both config/*.yaml files.
AZURE_OPENAI_DEPLOYMENT=gpt-6-astra

# Set this to true in your real shell, with `az login` done. Shown for reference only.
#AZURE_OPENAI_USE_DEFAULT_CREDENTIAL=true

# Optional: full path to the tokn binary if it is not on PATH.
#TOKN_BIN=<path-to-tokn>
