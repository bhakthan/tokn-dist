# Copy to .env and fill in. Placeholders only. Never commit .env.

# Your Azure AI Foundry endpoint. Auto-route needs the /openai/v1 form.
# Either host form works:
#   https://<your-resource>.services.ai.azure.com/openai/v1
#   https://<your-resource>.cognitiveservices.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1

# Deployment name of the configured (frontier) model. Name other rungs
# after their models too: gpt-6-luna, gpt-6.1-terra, gpt-6-astra.
# Deploy any subset; in the absence of a rung, TOKN moves its work one rung up.
AZURE_OPENAI_DEPLOYMENT=gpt-6.1-sol

# Option A: API key. Leave empty to use the az login token instead.
AZURE_OPENAI_API_KEY=

# Option B: Azure AD token, used when the API key is empty. Generate it with:
#   az account get-access-token --resource https://cognitiveservices.azure.com --query accessToken -o tsv
# Tokens expire, so regenerate it when a run reports an authentication error.
AZURE_OPENAI_AD_TOKEN=
