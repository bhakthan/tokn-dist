# Example environment for the PostgreSQL auto-ontology walkthrough.
#
# REFERENCE ONLY. This file is not loaded automatically. Export the values you
# need in your shell or secret store for each session. Never commit real values.

# PostgreSQL connection (placeholders only)
PGHOST=YOUR_SERVER.postgres.database.azure.com
PGPORT=5432
PGDATABASE=wideworldimporters
PGUSER=YOUR_POSTGRES_ROLE
# TLS: verify-full against an approved CA bundle
PGSSLMODE=verify-full
PGSSLROOTCERT=YOUR_APPROVED_CA_BUNDLE.pem
# PGPASSWORD is a fresh Microsoft Entra token. Set it in the process environment; do not store it here.
# PG_DSN should contain only the database name, for example dbname=tokn_orders_demo.
# Host, port, user, password, TLS mode and CA bundle come from the PG* variables above.

# Optional: Azure OpenAI for --enrich and for a separate embeddings client
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# Optional: Azure OpenAI embeddings for helpers/embed_retrieval.py. Use a
# separate endpoint variable so Responses/project settings are not overwritten.
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=YOUR_EMBEDDING_DEPLOYMENT

# Optional: Anthropic model for --enrich (Entra ID, no API key; placeholder host)
ANTHROPIC_BASE_URL=https://YOUR_RESOURCE.services.ai.azure.com/anthropic
ANTHROPIC_USE_DEFAULT_CREDENTIAL=true
# Model name: use the one your deployment exposes (--model-name), e.g. YOUR_MODEL_DEPLOYMENT
# This Anthropic host is separate from AZURE_OPENAI_ENDPOINT above.

# Optional: advisory decision review, run by the native build (ontology build --decision-review)
SYSTEMONE_BACKEND=microsoft
DECISION_API_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com
DECISION_API_MODEL=YOUR_DECISION_DEPLOYMENT
# Prefer Microsoft Entra ID (az login). If you must use a key, set DECISION_API_KEY
# in the process environment only. Never write a key in this file.
