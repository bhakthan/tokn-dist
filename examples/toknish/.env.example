# Template for reference; set values in your trusted shell and never commit .env.
# The wrappers load only the API keys below. They generate TOKN_WORKER_TOKEN
# for each run; the shared token is never read from this file.

# Cloud-provider credentials (not needed for local Ollama).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional offline mode for TOKN startup checks:
# TOKN_NO_REGISTER=1
# TOKN_NO_UPDATE_CHECK=1
