# Copy to .env and fill in only what you need. Never commit .env.

# Shared secret between the leader and the worker. Leave empty to have
# run-local generate a one-off value for each run.
TOKN_WORKER_TOKEN=<your shared token>

# Provider for the bench. ollama needs no key.
# Cloud providers: set the key your provider expects.
OPENAI_API_KEY=<your-openai-api-key>
ANTHROPIC_API_KEY=<your-anthropic-api-key>
