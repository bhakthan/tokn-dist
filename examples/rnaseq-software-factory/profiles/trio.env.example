# --profile trio: copy to ./.env (gitignored) or export
# in your shell. Placeholders only - never commit real values. run.py turns these
# into short-lived credential profiles ($TOKN_FACTORY_ENV_DIR/<name>.env) named
# by the spec's models: bindings, and deletes them when the run ends.

# Opus (architect, implementer, default). ANTHROPIC_BASE_URL is only for an Anthropic-compatible gateway.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# gpt-6-astra (product, reviewer, test, release, observer).
# Leave AZURE_OPENAI_API_KEY empty to use `az login` (Entra token).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Decision model for the review gate: azure | microsoft | compatible | openai | gemini | jev | local
FACTORY_DECISION_BACKEND=azure
# FACTORY_DECISION_MODEL=          # default: the backend's own decision model (microsoft: DECISION_API_MODEL)
# microsoft: DECISION_API_ENDPOINT= DECISION_API_KEY= DECISION_API_MODEL=
# Microsoft Decision-1.1 (set FACTORY_DECISION_BACKEND=microsoft and use these placeholders):
# DECISION_API_ENDPOINT=https://<your-decision-endpoint>
# DECISION_API_KEY=<your-key>
# DECISION_API_MODEL=decision-1.1
# compatible: SYSTEMONE_BASE_URL= SYSTEMONE_API_KEY= SYSTEMONE_MODEL=

# Model / deployment names (defaults shown)
# FACTORY_OPUS_MODEL=claude-opus-5-5
# FACTORY_ASTRA_MODEL=gpt-6-astra
