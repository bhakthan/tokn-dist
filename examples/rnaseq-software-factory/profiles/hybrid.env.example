# --profile hybrid: everything in trio.env.example, plus the open-weights and
# local models below. Placeholders only - never commit real values.

ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
FACTORY_DECISION_BACKEND=azure
# Optional: Microsoft Decision-1.1 as the review-gate decision model (set FACTORY_DECISION_BACKEND=microsoft)
# DECISION_API_ENDPOINT=https://<your-decision-endpoint>
# DECISION_API_KEY=<your-key>
# DECISION_API_MODEL=decision-1.1

# Implementer: Hugging Face open-weights coder, falling back to local ollama
HF_TOKEN=
# HF_BASE_URL=
# FACTORY_HF_CODER_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Test + observer roles: local ollama, data_boundary: local (must be loopback)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# FACTORY_OLLAMA_MODEL=qwen2.5-coder:7b     # run: ollama pull <model>

# Optional: real C2S-Scale showcase after the single-cell feature loop (report-only).
# Needs llama.cpp's llama-server (winget install ggml.llamacpp | brew install llama.cpp)
# and a C2S-Scale GGUF, e.g. mradermacher/C2S-Scale-Gemma-2-2B-GGUF Q4_K_M (~1.6 GB).
# FACTORY_C2S_GGUF=<path>\C2S-Scale-Gemma-2-2B.Q4_K_M.gguf
# FACTORY_C2S_SHA256=              # pin the weights; run.py refuses a mismatching file
# FACTORY_C2S_PORT=8091            # loopback port for the launched llama-server
# FACTORY_LLAMA_SERVER=            # llama-server path when it is not on PATH