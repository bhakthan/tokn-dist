
# Copy this file to .env and replace the placeholders with your own values.
# Every URL here is a loopback address on this machine. Nothing leaves it.

# Coding model (run-agent). The llama.cpp server started on port 8083.
GGUF_SERVER_URL=http://127.0.0.1:8083/v1

# Model id the coding server reports at /v1/models.
TOKN_MODEL=<coder-model-id>

# Optional: path to the tokn binary if it is not on PATH.
#TOKN_BIN=<path-to-tokn>

# Optional: the Hugging Face repo and quant start-models.ps1 / start-models.sh
# use for the coding model (for example <hf-repo>:<quant>).
#CODER_HF_MODEL=<hf-repo>:<quant>

# ---------------------------------------------------------------------------
# Set these in your SHELL, not in this file. The scripts skip them on purpose,
# and TOKN refuses routing and destination keys from a repository .env.
#
# Vision model (run-inspection):
#   TOKN_INSPECT_SCORER=logprob
#   TOKN_INSPECT_ALLOW_LOCAL=1
#   TOKN_INSPECT_BASE_URL=http://127.0.0.1:8081/v1
#   TOKN_INSPECT_MODEL=<name in the server's /v1/models list>
#
# Decision model (run-triage):
#   SYSTEMONE_BACKEND=compatible
#   SYSTEMONE_ALLOW_LOCAL=1
#   SYSTEMONE_BASE_URL=http://127.0.0.1:8082/v1
#   SYSTEMONE_MODEL=clef-flash
# ---------------------------------------------------------------------------
