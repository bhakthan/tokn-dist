{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|create_file",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%CLAUDE_PROJECT_DIR%\\hooks\\block_protected.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|create_file",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%CLAUDE_PROJECT_DIR%\\hooks\\audit_write.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
