{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|create_file",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/hooks/block_protected.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|create_file",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/hooks/audit_write.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
