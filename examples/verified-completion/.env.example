# Template for reference; export routing, endpoint and binary settings in a trusted shell.
# The scripts do not read this file; they read the environment only.

# Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=  # only for an operator-selected compatible gateway

# Azure OpenAI, optional. Configure the endpoint in a trusted shell.
# AZURE_OPENAI_API_KEY=

# Which model the scripts pass to tokn; set in a trusted process environment.
# TOKN_EXAMPLE_PROVIDER=anthropic
# TOKN_EXAMPLE_MODEL=YOUR_MODEL_ID

# Optional: set TOKN to an installed binary in your trusted shell if it is not on PATH.
