# Copy to .env for reference, then export the values you need in your shell.
# The scripts do not read this file; they read the environment only.

# Anthropic (claude-opus-5-5)
ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_BASE_URL=https://your-compatible-gateway.example

# Azure OpenAI (gpt-6-astra), optional
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-openai-key

# Which model the scripts pass to tokn
TOKN_EXAMPLE_PROVIDER=anthropic
TOKN_EXAMPLE_MODEL=claude-opus-5-5

# Optional: path to the tokn binary if it is not on PATH
# TOKN=C:\path\to\tokn.exe
