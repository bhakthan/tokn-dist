{
  "adapter": "proteinmpnn",
  "enabled": true,
  "gpu_uuid": "<reviewed selected local GPU UUID>",
  "source_root": "/absolute/private/staging/proteinmpnn-source",
  "weights_root": "/absolute/private/staging/proteinmpnn-weights",
  "output_root": "/absolute/private/state/proteinmpnn-output",
  "scratch_root": "/absolute/private/tmpfs/proteinmpnn-scratch",
  "docker_socket": "/var/run/docker.sock",
  "image_id": "sha256:<reviewed ProteinMPNN image content ID>",
  "reviewer_key": "<base64 external design reviewer Ed25519 PUBLIC key>",
  "policy_version": "external-review-design-v1",
  "source_manifest": {
    "<every-relative-source-file>": "<SHA256>"
  },
  "weights_manifest": {
    "<every-relative-cache-and-data-file>": "<SHA256>"
  },
  "data_terms_sha256": "<SHA256 of reviewed ancillary-data terms evidence>",
  "revoked_ids": [],
  "timeout_seconds": 3600,
  "memory_mib": 32768,
  "cpus": 8
}
