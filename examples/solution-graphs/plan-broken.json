{
  "schema": "tokn.solution/1",
  "requirement": "Create the synthetic delivery example and measure the baseline model.",
  "domain": "general",
  "nodes": [
    {
      "id": "scaffold",
      "kind": "tabular",
      "target": "tabular_scaffold",
      "input": { "directory": "delivery", "example": "delivery" }
    },
    {
      "id": "evaluate",
      "kind": "tabular",
      "target": "tabular_evaluate",
      "input": { "spec": "delivery/problem.json" },
      "depends_on": ["scaffold"]
    }
  ],
  "checks": [
    { "ref": "evaluate#/metrics", "operator": "exists" }
  ]
}
