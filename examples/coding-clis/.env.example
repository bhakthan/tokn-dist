# No TOKN model, endpoint or key is required to use the MCP connection.
# Peer CLIs may use their own sign-in. These optional names are used only by Copilot CLI:
# COPILOT_GITHUB_TOKEN=
# GH_TOKEN=
# Optional TOKN startup settings for your trusted shell:
# TOKN_NO_REGISTER=1
# TOKN_NO_UPDATE_CHECK=1
