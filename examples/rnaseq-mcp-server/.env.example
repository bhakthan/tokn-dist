# Template for reference only. Prefer setting these in a trusted shell; do not
# source this file or commit a populated .env. Empty values do not satisfy preflight.
# The launchers read ONLY ANTHROPIC_API_KEY from a local .env, and only when it is
# not already set. Endpoint and routing settings are never read from this file.

# Anthropic API key, or the key issued by your Anthropic-compatible gateway.
ANTHROPIC_API_KEY=

# Set in your trusted shell, not here, if you use an Anthropic-compatible gateway:
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_HEADER=

# Model is chosen by the launcher (-Model / MODEL), provider is anthropic.
# Optional: TOKN_NO_REGISTER=1 and TOKN_NO_UPDATE_CHECK=1
