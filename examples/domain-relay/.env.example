# Domain relay — copy this file to `.env` in this folder (it is git-ignored) and fill in YOUR values.
# Never commit .env. run.py reads only the keys below, by exact name, and lists any that are missing.
# Values may also come from your shell environment, which takes precedence over this file.

# ── Gateway for four of the models ────────────────────────────────────────────────
# One HTTPS base URL that serves BOTH routes:
#   <RELAY_GATEWAY_URL>/openai/v1   OpenAI-compatible chat completions: Kimi-K3.1-Pro, FW-GLM-5.3
#   <RELAY_GATEWAY_URL>/anthropic   Anthropic Messages API:             claude-opus-5-5, claude-haiku-5-5
# Example shape only:  https://my-gateway.example.com/my-api
RELAY_GATEWAY_URL=https://<your-gateway-host>/<your-api-path>

# Subscription key the gateway expects on the OpenAI-compatible route.
APIM_KEY=<your-openai-route-key>

# Key the gateway expects on the Anthropic route.
FAST_API_KEY=<your-anthropic-route-key>

# ── gpt-6.1-sol (reviser) ─────────────────────────────────────────────────────────
# Your Azure OpenAI / Foundry account endpoint that has a gpt-6.1-sol deployment.
# No key here: run `az login` first; run.py fetches a short-lived token for you.
# Example shape only:  https://<your-account>.cognitiveservices.azure.com/openai/v1
RELAY_FOUNDRY_URL=https://<your-account-endpoint>/openai/v1

# ── Microsoft-Decision-1 (decision gate) ──────────────────────────────────────────
# Used through `tokn system-one evaluate`; returns typed yes/no probabilities.
DECISION_API_ENDPOINT=https://<your-decision-endpoint>
DECISION_API_KEY=<your-decision-key>
