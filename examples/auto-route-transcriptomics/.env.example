# Copy to .env and fill in. Placeholders only. Never commit .env.

# Anthropic API key, or the key issued by your Anthropic-compatible gateway.
ANTHROPIC_API_KEY=<your-key>

# Optional: an Anthropic-compatible gateway. Leave commented to use the default endpoint.
# ANTHROPIC_BASE_URL=https://<your-gateway>/anthropic

# Optional: override the auth header the endpoint expects. Azure API Management
# gateways (hosts ending in .azure-api.net) use the api-key header automatically.
# ANTHROPIC_AUTH_HEADER=<header-name>

# Alternative to the --auto-route flag: enable routing for every run in this shell.
# TOKN_AUTO_ROUTE=1
